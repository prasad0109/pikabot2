{
  "server": {
    "host": "play.example-server.net",
    "port": 25565,
    "version": "1.20.4"
  },

  "settings": {
    "reconnectDelaySeconds": 15,
    "startupCommands": {
      "delaySeconds": 2,
      "commands": [
        "/register {password} {password}",
        "/login {password}",
        "/server survival"
      ]
    },
    "antiAfk": {
      "enabled": true,
      "jitterSeconds": 5,
      "actions": ["jump", "look", "walkBack"]
    },
    "autoMine": {
      "enabled": true,
      "targetBlocks": ["diamond_ore", "deepslate_diamond_ore"],
      "scanRadius": 32,
      "reachDistance": 4.5,
      "scanIntervalSeconds": 5,
      "keepItems": ["diamond"]
    },
    "chatMessages": {
      "enabled": false,
      "intervalMinutes": 30,
      "messages": ["afk"]
    },
    "staggerStartSeconds": 3
  },

